# Copy to .env to override compose defaults.

# Host port for the ledger database. Change this if the host already runs a
# native Postgres on 5432 (docker will refuse to bind otherwise).
DB_PORT=5432

# The within_cap CHECK. TRUE during normal development (a loud safety net).
# The harness drops it per run regardless, via POST /admin/db-constraint.
ENFORCE_DB_CONSTRAINT=true

# Simulated application work inside the naive read->write gap, in milliseconds.
# MUST default to 0: the breach has to reproduce without it. Any non-zero value
# is recorded in the results CSV.
NAIVE_RACE_DELAY_MS=0

# Must be >= the harness worker count or requests serialise at the pool.
POOL_MIN_SIZE=10
POOL_MAX_SIZE=120

# Seeding, constraint toggling and fault injection. Never enable in anything
# resembling production.
ALLOW_ADMIN_ENDPOINTS=true
